# Dhaga Diaries — Environment Configuration Template
# Copy this file to .env.local and update with your credentials

# ========================================================
# 1. Razorpay Payment Gateway (Test or Live)
# ========================================================
# Obtain your API keys from Razorpay Dashboard > Settings > API Keys
# In Test mode, use keys starting with "rzp_test_"
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_51xxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_51xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Razorpay Webhook Secret (Configured in Razorpay Dashboard > Webhooks)
# Webhook URL: https://yourdomain.com/api/checkout/webhook
# Events: payment.captured, payment.failed, order.paid, refund.processed
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ========================================================
# 2. Admin Authentication & Security
# ========================================================
# Strong random string for signing HTTP-only admin JWT session cookies
ADMIN_JWT_SECRET=generate-a-strong-32-character-secret-key-here

# ========================================================
# 3. Supabase Database & Storage (Optional for Cloud Deploy)
# ========================================================
# When left empty, the application seamlessly runs using the local persistent database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
